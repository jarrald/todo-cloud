<mxfile host="app.diagrams.net" type="device">
  <diagram id="deployment-workflow" name="Deployment workflow">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Deployment workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="legendManual" value="MANUAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97745;fontColor=#873B1C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="10" width="90" height="30" as="geometry"/></mxCell>
        <mxCell id="legendAuto" value="AUTOMATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="10" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;1 · Prepare&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#873B1C&quot;&gt;MANUAL&lt;/font&gt;&lt;br&gt;Commit and push to main&lt;br&gt;Sign in to Azure and GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97745;fontColor=#542B1A;fontSize=14;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="script" value="&lt;b&gt;2 · Start deployment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#873B1C&quot;&gt;MANUAL&lt;/font&gt;&lt;br&gt;Run &lt;font face=&quot;monospace&quot;&gt;infra/deploy.sh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97745;fontColor=#542B1A;fontSize=14;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="check" value="&lt;b&gt;3 · Preflight checks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Check tools and authentication&lt;br&gt;Clean relevant files; verify main commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="provision" value="&lt;b&gt;4 · Provision Azure&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Deploy Bicep resources&lt;br&gt;Create GitHub federated identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="k8s" value="&lt;b&gt;5 · Configure AKS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Set database secret&lt;br&gt;Apply deployments and services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="235" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="addresses" value="&lt;b&gt;6 · Configure endpoints&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Wait for service addresses&lt;br&gt;Configure Function CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="235" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;7 · Configure GitHub&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Set Actions secrets&lt;br&gt;and variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="235" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="function" value="&lt;b&gt;8 · Deploy Function&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Run and wait for Function workflow&lt;br&gt;OIDC identity deploys Function" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;9 · Deploy API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Run and wait for API workflow&lt;br&gt;Build image → ACR → AKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;b&gt;10 · Deploy frontend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Run and wait for frontend workflow&lt;br&gt;Build with URLs → ACR → AKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="verify" value="&lt;b&gt;11 · Verify application&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#205638&quot;&gt;AUTOMATED&lt;/font&gt;&lt;br&gt;Check API, frontend, statistics&lt;br&gt;and CORS; print frontend URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#4E9B6B;fontColor=#205638;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;Optional · Cleanup later&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#873B1C&quot;&gt;MANUAL&lt;/font&gt;&lt;br&gt;Run &lt;font face=&quot;monospace&quot;&gt;infra/destroy.sh&lt;/font&gt;&lt;br&gt;Confirm deletion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97745;fontColor=#542B1A;fontSize=14;spacing=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="script" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="script" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="check" target="provision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="provision" target="k8s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="k8s" target="addresses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="addresses" target="secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="secrets" target="function" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="function" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="api" target="app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="app" target="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="verify" target="cleanup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8A94A6;strokeWidth=2;dashed=1;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
